    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3MkIzOTBDMTJGNjA4RUMKUldUc0NQWVNERGtyNThuRUR6eThRdzRlWTJaWnU4MmtBakppSXVnT0JKaTl4WTdSbDBoampjRjAK",
      "endpoints": [
        "https://github.com/danjoakim/pling-test/releases/latest/download/latest.json"
      ],
      "windows": {
